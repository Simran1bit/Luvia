# Copy the relevant DATABASE_URL from your existing LUVIA backend .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional: specify exact table names after checking your LUVIA schema.
# LUVIA_CHAT_EVENT_TABLE=weather_events
# LUVIA_CHAT_WARNING_TABLE=imd_warnings
LUVIA_CHAT_TIMEOUT=12
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
